# ==============================================================================
# CLAUDE CODE - LOCAL DEVELOPMENT SECRETS
# ==============================================================================

# Get a Fine-Grained GitHub Personal Access Token (Scoped ONLY to this specific repository)
# Permissions needed: Contents (Read & Write)
# Generate here: https://github.com/settings/personal-access-tokens/new
# Note, you might not need GitHub token at all if Claude doesn't have to access the remote repository
GH_HOST=
GH_TOKEN=

# Adaptive thinking is enabled by default so Claude can consume more tokens if it sees the request is complex.
# It can be disabled with this environment variable.
# CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING=1
